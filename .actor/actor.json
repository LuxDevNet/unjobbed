{
  "actorSpecification": 1,
  "name": "unjobbed",
  "title": "Unjobbed: craw jobs plugin",
  "description": "Private craw jobs plugin. Default scrape is public pages. The jobs pipeline defaults to public APIs and ATS feeds. Needs-route boards are opt-in. Not a Store listing.",
  "version": "1.1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Jobs",
          "transformation": { "fields": ["score", "title", "company", "location", "workMode", "salary.annualMin", "salary.annualMax", "postedAt", "seenOn", "url", "isNew"] },
          "display": { "component": "table", "properties": { "url": { "format": "link" } } }
        }
      }
    }
  }
}
